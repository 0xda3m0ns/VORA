PROGRAM main
  VAR
    LEVEL_PCT : INT AT %IW0;
    ALARM : BOOL AT %QX0.0;
    RESET : BOOL AT %IX0.0;
    PREV_RESET : BOOL := FALSE;
    LATCHED : BOOL := FALSE;
  END_VAR

IF LEVEL_PCT >= 90 THEN
    LATCHED := TRUE;
ELSIF RESET AND NOT PREV_RESET THEN
    LATCHED := FALSE;
END_IF;

PREV_RESET := RESET;
ALARM := LATCHED;

END_PROGRAM